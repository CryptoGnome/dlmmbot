# Copy to .env and fill in. NEVER commit .env.

# Solana RPC (Helius/FluxRPC recommended; public RPC works for paper-mode smoke tests)
RPC_URL=https://api.mainnet-beta.solana.com
# Optional fallback RPC used by the safety watchdog
RPC_URL_FALLBACK=

# Jupiter API key (free tier: https://portal.jup.ag) — needed for zap-out swaps in live mode
JUPITER_API_KEY=

# GMGN API key — optional discovery enrichment, scanner works without it
GMGN_API_KEY=

# Wallet secret — LIVE MODE ONLY; scanner/vetting never read it, only the executor.
# Option A: base58 private key exported from Phantom (takes priority if both set)
WALLET_PRIVATE_KEY=
# Option B: path to burner-wallet keypair JSON (solana-keygen format)
WALLET_KEYPAIR_PATH=

# Must be set to "live" IN ADDITION to [exec].mode="live" in config.toml for real trades
FARMER_MODE=paper

# LAN ops dashboard (meteora-dash PM2 app) — required to serve http://HOST:8787
DASH_TOKEN=
DASH_PORT=8787

# Telegram alerts (optional): create a bot via @BotFather, get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
