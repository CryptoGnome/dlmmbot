# Copy to .env and fill in. NEVER commit .env.

# Solana RPC — Helius recommended (https://www.helius.dev/)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# Optional fallback RPC used by the safety watchdog
RPC_URL_FALLBACK=

# Jupiter API key — free at https://developers.jup.ag/portal (needed for exit swaps / simulate-zap)
JUPITER_API_KEY=

# GMGN API key — optional, free at https://gmgn.ai/ai (Ed25519 public key upload — see docs/setup/api-keys)
GMGN_API_KEY=

# Wallet secret — LIVE MODE ONLY; scanner/vetting never read it, only the executor.
# Option A: base58 private key exported from Phantom (takes priority if both set)
WALLET_PRIVATE_KEY=
# Option B: path to burner-wallet keypair JSON (solana-keygen format)
WALLET_KEYPAIR_PATH=

# Must be set to "live" IN ADDITION to [exec].mode="live" in config.toml for real trades
FARMER_MODE=paper

# LAN ops dashboard (meteora-dash PM2 app / Railway) — required. ≥24 random chars.
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DASH_TOKEN=
DASH_PORT=8787

# Telegram alerts (optional): create a bot via @BotFather, get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
