{
  "name": "dlmmbot-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily X update video for DLMM Bot — data from the live dashboard API, rendered with Remotion.",
  "scripts": {
    "data": "node scripts/data.mjs",
    "capture": "node scripts/capture.mjs",
    "daily": "npm run data && npm run capture && npm run render",
