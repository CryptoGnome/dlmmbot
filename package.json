{
  "name": "dlmmbot",
  "version": "0.3.4",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "description": "Automated Meteora DLMM LP bot for Solana — scan, vet, enter, manage, exit. Paper mode by default.",
  "repository": {
    "type": "git",
    "url": "https://github.com/CryptoGnome/dlmmbot.git"
  },
  "type": "module",
  "scripts": {
    "scan": "tsx src/cli.ts scan",
    "vet": "tsx src/cli.ts vet",
    "run": "tsx src/cli.ts run",
    "status": "tsx src/cli.ts status",
    "halt": "tsx src/cli.ts halt",
    "pause": "tsx src/cli.ts pause",
    "release": "tsx src/cli.ts release",
    "force-close": "tsx src/cli.ts force-close",
    "heartbeat-check": "node deploy/heartbeat-check.cjs",
    "simulate-zap": "tsx deploy/simulate-zap.ts",
    "dash": "node deploy/dashboard-server.mjs",
    "dash:build": "npm --prefix dashboard ci && npm --prefix dashboard run build",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site ci && npm --prefix docs-site run build",
    "railway:start": "node deploy/railway-start.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:deploy": "tsc -p tsconfig.deploy.json",
    "build": "tsc",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "validate:profiles": "node scripts/validate-profiles.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "^1.5.0",
    "@meteora-ag/zap-sdk": "^1.3.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.95.0",
    "better-sqlite3": "^11.8.0",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "gmgn-cli": "^1.5.6",
    "smol-toml": "^1.3.1",
    "tsx": "^4.23.12",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
