{
  "name": "meteora-farmer",
  "version": "0.1.0",
  "private": true,
  "description": "Automated Meteora DLMM LP farmer — scan, vet, enter, manage, exit. Paper mode by default.",
  "type": "module",
  "scripts": {
    "scan": "tsx src/cli.ts scan",
    "vet": "tsx src/cli.ts vet",
    "run": "tsx src/cli.ts run",
    "status": "tsx src/cli.ts status",
    "halt": "tsx src/cli.ts halt",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "^1.5.0",
    "@solana/web3.js": "^1.95.0",
    "better-sqlite3": "^11.8.0",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "gmgn-cli": "^1.5.6",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
